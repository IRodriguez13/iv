# bash completion for iv(1) -*- shell-script -*-

_iv()
{
	local cur prev
	local words cword

	_init_completion -n : || return

	cur=${COMP_WORDS[COMP_CWORD]}
	prev=${COMP_WORDS[COMP_CWORD-1]}

	local cmds="-h --help -V --version -v -va -i -insert -a -p -pi -d -delete -r -replace -s"
	local opts="--dry-run --no-numbers -g -E --regex -q --stdout -m -F -e -b --backup --suffix -S"

	if [[ ${COMP_CWORD} -eq 1 ]]; then
		COMPREPLY=( $(compgen -W "${cmds}" -- "${cur}") )
		return
	fi

	case "${prev}" in
		-m|-F|-e|-S|--suffix)
			return
			;;
		--backup)
			COMPREPLY=( $(compgen -W "none numbered existing simple off t nil never" -- "${cur}") )
			return
			;;
	esac

	if [[ "${cur}" == --backup=* ]]; then
		COMPREPLY=( $(compgen -W "none numbered existing simple" -- "${cur#--backup=}") )
		return
	fi

	if [[ "${cur}" == -* ]]; then
		COMPREPLY=( $(compgen -W "${cmds} ${opts}" -- "${cur}") )
		return
	fi

	_filedir
} &&
	complete -F _iv iv

