#compdef iv
# zsh completion for iv(1)

_iv() {
	local curcontext="$curcontext" state line
	typeset -A opt_args

	local -a cmds
	cmds=(
		'-v:view file with line numbers'
		'-va:view line range'
		'-wc:count lines'
		'-n:line numbers matching pattern'
		'-nv:lines matching pattern'
		'-i:insert text'
		'-insert:insert text'
		'-a:append text'
		'-p:patch file(s)'
		'-pi:patch insert before line'
		'-d:delete lines'
		'-delete:delete lines'
		'-r:replace lines'
		'-replace:replace lines'
		'-s:search and replace'
	)

	_arguments -s -S \
		'(-h --help)'{-h,--help}'[Show help]' \
		'(-V --version)'{-V,--version}'[Show version]' \
		'--dry-run[Show changes without writing]' \
		'--no-numbers[Omit line numbers in view output]' \
		'-g[Replace all matches per line]' \
		'(-E --regex)'{-E,--regex}'[Use regex in substitute]' \
		'-q[Quiet tee output]' \
		'--stdout[Write to stdout without modifying file]' \
		'--json[JSON output for -n]' \
		'-b[GNU backup (existing)]' \
		'--backup=-[GNU backup method]:method:(none numbered existing simple)' \
		'-S+[Backup suffix]:suffix:' \
		'--suffix=-[Backup suffix]:suffix:' \
		'-m+[Apply only to matching lines]:pattern:' \
		'-F+[Replace delimiter-separated field N]:delimiter field value:' \
		'-e+[Extra substitute pattern]:pattern replacement:' \
		'1:command:->cmd' \
		'*::arg:->args'

	case $state in
		cmd)
			_describe -t commands 'iv command' cmds
			;;
		args)
			case $words[1] in
				-v|-va|-wc|-n|-nv|-i|-insert|-a|-p|-pi|-d|-delete|-r|-replace|-s)
					_files
					;;
			esac
			;;
	esac
}

_iv "$@"
